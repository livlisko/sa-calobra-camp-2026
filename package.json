{
  "name": "sa-calobra-camp-2026",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:map",
    "build:map": "npm run typecheck:map && vite build --config vite.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck:map": "tsc --noEmit -p tsconfig.map.json",
    "verify": "npm run build:map && npm test"
  },
  "dependencies": {
    "fit-file-parser": "6.2.3",
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
